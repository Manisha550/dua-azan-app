/* ================================ BACKEND ================================ */
const MIME = { '.mp3': 'audio/mpeg', '.ogg': 'audio/ogg', '.wav': 'audio/wav' };
const cache = new Map();

async function prayerTimes(u) {
  const lat = parseFloat(u.searchParams.get('latitude') || 22.3569);
  const lng = parseFloat(u.searchParams.get('longitude') || 91.7832);
  const method = parseInt(u.searchParams.get('method') || 1, 10);
  const school = parseInt(u.searchParams.get('school') || 1, 10);
  let date = u.searchParams.get('date') || '';
  if (!/^\d{2}-\d{2}-\d{4}$/.test(date)) {
    const n = new Date();
    date = String(n.getDate()).padStart(2, '0') + '-' + String(n.getMonth() + 1).padStart(2, '0') + '-' + n.getFullYear();
  }
  if ([lat, lng, method, school].some(Number.isNaN)) throw new Error('bad params');
  const key = [date, lat, lng, method, school].join('|');
  if (cache.has(key)) return cache.get(key);
  const url = 'https://api.aladhan.com/v1/timings/' + date + '?latitude=' + lat + '&longitude=' + lng + '&method=' + method + '&school=' + school;
  const r = await fetch(url);
  if (!r.ok) throw new Error('upstream ' + r.status);
  const t = (await r.json()).data.timings, out = {};
  ['Fajr', 'Dhuhr', 'Asr', 'Maghrib', 'Isha'].forEach(k => { out[k.toLowerCase()] = String(t[k]).slice(0, 5); });
  cache.set(key, out);
  return out;
}

function send(res, code, type, body) {
  res.writeHead(code, { 'Content-Type': type + '; charset=utf-8', 'Cache-Control': 'no-cache' });
  res.end(body);
}

const server = http.createServer(async (req, res) => {
  const u = new URL(req.url, 'http://localhost');
  try {
    if (u.pathname === '/' || u.pathname === '/index.html') return send(res, 200, 'text/html', HTML);
    if (u.pathname === '/sw.js') return send(res, 200, 'application/javascript', SW);
    if (u.pathname === '/manifest.json') return send(res, 200, 'application/manifest+json', MANIFEST);
    if (u.pathname === '/icon.svg') return send(res, 200, 'image/svg+xml', ICON);
    if (u.pathname === '/duas.json' || u.pathname === '/api/duas') return send(res, 200, 'application/json', JSON.stringify(verifiedDuas()));
    if (u.pathname === '/api/duas/needs-verification')
      return send(res, 200, 'application/json', JSON.stringify(loadAll().filter(d => d.status !== 'verified')));
    if (u.pathname === '/api/prayer-times') {
      try { return send(res, 200, 'application/json', JSON.stringify(await prayerTimes(u))); }
      catch (e) { return send(res, 502, 'application/json', JSON.stringify({ error: 'prayer time service unavailable' })); }
    }
    if (u.pathname.startsWith('/audio/')) {
      const f = path.join(__dirname, 'audio', path.basename(u.pathname));
      if (fs.existsSync(f)) {
        res.writeHead(200, { 'Content-Type': MIME[path.extname(f)] || 'application/octet-stream' });
        return fs.createReadStream(f).pipe(res);
      }
    }
    send(res, 404, 'text/plain', 'Not found');
  } catch (e) { send(res, 500, 'text/plain', 'Server error'); }
});

/* ================================== MAIN ================================= */
function exportWww() {
  const dir = path.join(__dirname, 'www');
  fs.mkdirSync(dir, { recursive: true });
  fs.writeFileSync(path.join(dir, 'index.html'), HTML);
  fs.writeFileSync(path.join(dir, 'sw.js'), SW);
  fs.writeFileSync(path.join(dir, 'manifest.json'), MANIFEST);
  fs.writeFileSync(path.join(dir, 'icon.svg'), ICON);
  fs.writeFileSync(path.join(dir, 'duas.json'), JSON.stringify(verifiedDuas(), null, 2));
  console.log('Exported ./www  (verified duas: ' + verifiedDuas().length + ')');
}

if (process.argv.includes('--audit')) {
  runAudit();
} else if (process.argv.includes('--export')) {
  exportWww();
} else {
  server.listen(PORT, () => {
    console.log('Dua & Azan running on http://localhost:' + PORT);
    if (process.versions.electron) {
      const { app, BrowserWindow } = require('electron');
      let win, quitting = false;
      app.on('before-quit', () => { quitting = true; });
      app.whenReady().then(() => {
        win = new BrowserWindow({ width: 1000, height: 760, webPreferences: { backgroundThrottling: false, autoplayPolicy: 'no-user-gesture-required' } });
        win.loadURL('http://localhost:' + PORT);
        // closing minimizes instead, so azan/alarms keep working. Quit from File menu.
        win.on('close', e => { if (!quitting) { e.preventDefault(); win.minimize(); } });
        app.setLoginItemSettings({ openAtLogin: true });
      });
      app.on('window-all-closed', e => e.preventDefault());
    }
  });
}