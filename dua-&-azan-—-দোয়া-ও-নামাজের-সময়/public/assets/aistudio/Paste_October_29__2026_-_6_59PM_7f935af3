/* Client code is a real function (so Node syntax-checks it); it is
   serialised with toString() and placed inside the page's <script>. */
function client() {
  'use strict';
  const PRAYERS = [['fajr', 'ফজর'], ['dhuhr', 'যোহর'], ['asr', 'আসর'], ['maghrib', 'মাগরিব'], ['isha', 'এশা']];
  const DEFAULTS = {
    lat: 22.3569, lng: 91.7832, method: 1, school: 1,
    azan: { fajr: true, dhuhr: true, asr: true, maghrib: true, isha: true },
    tahajjud: { enabled: false, mode: 'lastThird', custom: '03:30' },
    alarms: []
  };
  const $ = (s, r = document) => r.querySelector(s);
  const pad = n => String(n).padStart(2, '0');
  const load = (k, d) => { try { const v = JSON.parse(localStorage.getItem(k)); return v == null ? d : v; } catch (e) { return d; } };
  const save = (k, v) => { try { localStorage.setItem(k, JSON.stringify(v)); } catch (e) {} };
  const h = (t, a = {}, ...c) => {
    const e = document.createElement(t);
    for (const [k, v] of Object.entries(a)) {
      if (k === 'class') e.className = v;
      else if (k.startsWith('on')) e.addEventListener(k.slice(2), v);
      else if (v !== false && v != null) e.setAttribute(k, v === true ? '' : v);
    }
    e.append(...c); return e;
  };

  const S = Object.assign({}, DEFAULTS, load('settings', {}));
  S.azan = Object.assign({}, DEFAULTS.azan, S.azan);
  S.tahajjud = Object.assign({}, DEFAULTS.tahajjud, S.tahajjud);
  const persist = () => { save('settings', S); refresh(); };

  const addDays = (d, n) => { const x = new Date(d); x.setDate(x.getDate() + n); return x; };
  const ymd = d => d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate());
  const atTime = (d, hhmm) => { const p = hhmm.split(':').map(Number); const x = new Date(d); x.setHours(p[0], p[1], 0, 0); return x; };
  const fmtT = d => d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

  /* ---- duas (verified only; filtered again on the client as a safety net) ---- */
  const complete = d => ['arabic', 'bengali', 'context', 'repetition'].every(k => typeof d[k] === 'string' && d[k].trim()) &&
    d.source && d.source.type && d.source.ref;
  let duas = [], favs = load('favs', []), cat = 'all', q = '';

  async function loadDuas() {
    let list = null;
    for (const url of ['/api/duas', 'duas.json']) {
      try {
        const r = await fetch(url); if (!r.ok) continue;
        const j = await r.json(); list = Array.isArray(j) ? j : j.duas;
        if (list) break;
      } catch (e) { /* try next */ }
    }
    if (list) save('duasCache', list); else list = load('duasCache', []);
    return list.filter(d => d.status === 'verified' && complete(d));
  }

  function renderDuas() {
    const cats = [['all', 'সব'], ['fav', '★ প্রিয়']].concat([...new Set(duas.map(d => d.category))].map(c => [c, c]));
    $('#chips').replaceChildren(...cats.map(([k, label]) =>
      h('button', { class: k === cat ? 'on' : '', onclick: () => { cat = k; renderDuas(); } }, label)));
    const list = duas.filter(d =>
      (cat === 'all' || (cat === 'fav' ? favs.includes(d.id) : d.category === cat)) &&
      (!q || (d.bengali + d.context + d.category + d.source.ref).toLowerCase().includes(q)));
    const box = $('#duaList'); box.replaceChildren();
    if (!list.length) box.append(h('p', { class: 'meta' }, 'কোনো যাচাইকৃত দোয়া পাওয়া যায়নি।'));
    list.forEach(d => {
      const cnt = h('button', { class: 'ghost' }, '0');
      cnt.onclick = () => { cnt.textContent = +cnt.textContent + 1; };
      const fav = h('button', { class: 'ghost' }, favs.includes(d.id) ? '★' : '☆');
      fav.onclick = () => { favs = favs.includes(d.id) ? favs.filter(x => x !== d.id) : favs.concat(d.id); save('favs', favs); renderDuas(); };
      const copy = h('button', { class: 'ghost' }, 'কপি');
      copy.onclick = () => { if (navigator.clipboard) navigator.clipboard.writeText(d.arabic + '\n' + d.bengali + '\n(' + d.source.ref + ')'); };
      box.append(h('article', { class: 'card' },
        h('p', { class: 'ar', dir: 'rtl', lang: 'ar' }, d.arabic),
        h('p', { class: 'bn' }, d.bengali),
        h('p', { class: 'meta' }, '📖 ' + d.source.ref),
        h('p', { class: 'meta' }, '🕐 ' + d.context),
        h('p', { class: 'meta' }, '🔁 ' + d.repetition),
        h('div', { class: 'actions' }, cnt, h('button', { class: 'ghost', onclick: () => { cnt.textContent = '0'; } }, '↺'), fav, copy)));
    });
  }

  /* ---- prayer times ---- */
  const pick = (o, k) => String(o[k] || o[k[0].toUpperCase() + k.slice(1)] || '').slice(0, 5);
  async function getTimes(date) {
    const key = 't_' + ymd(date) + '_' + S.lat + '_' + S.lng + '_' + S.method + '_' + S.school;
    const cached = load(key, null); if (cached) return cached;
    const dd = pad(date.getDate()) + '-' + pad(date.getMonth() + 1) + '-' + date.getFullYear();
    const qs = 'latitude=' + S.lat + '&longitude=' + S.lng + '&method=' + S.method + '&school=' + S.school;
    const urls = [];
    if (!window.Capacitor) urls.push('/api/prayer-times?date=' + dd + '&' + qs);
    urls.push('https://api.aladhan.com/v1/timings/' + dd + '?' + qs);
    for (const u of urls) {
      try {
        const r = await fetch(u); if (!r.ok) continue;
        const j = await r.json(); const t = (j.data && j.data.timings) || j;
        const out = {}; PRAYERS.forEach(p => { out[p[0]] = pick(t, p[0]); });
        if (Object.values(out).every(v => /^\d{2}:\d{2}$/.test(v))) { save(key, out); return out; }
      } catch (e) { /* try next */ }
    }
    throw new Error('prayer times unavailable');
  }

  /* ---- events: azan, tahajjud, alarms ---- */
  async function dayEvents(off) {
    const base = addDays(new Date(), off);
    const both = await Promise.all([getTimes(addDays(base, -1)), getTimes(base)]);
    const y = both[0], t = both[1];
    const ev = [];
    PRAYERS.forEach((p, i) => ev.push({ id: ymd(base) + '-' + p[0], kind: 'azan', key: p[0], label: p[1] + ' আযান', at: atTime(base, t[p[0]]), on: !!S.azan[p[0]], code: i }));
    // night = yesterday Maghrib -> today Fajr ; last third starts at Fajr - night/3
    const start = atTime(addDays(base, -1), y.maghrib), end = atTime(base, t.fajr);
    const tj = S.tahajjud.mode === 'custom' ? atTime(base, S.tahajjud.custom) : new Date(end - (end - start) / 3);
    ev.push({ id: ymd(base) + '-tahajjud', kind: 'tahajjud', label: 'তাহাজ্জুদের সময়', at: tj, on: S.tahajjud.enabled, code: 5 });
    S.alarms.forEach((a, i) => {
      const days = a.days || [];
      if (!days.length || days.includes(base.getDay()))
        ev.push({ id: ymd(base) + '-alarm-' + a.id, kind: 'alarm', label: a.label || 'অ্যালার্ম', at: atTime(base, a.time), on: a.on, code: 10 + i });
    });
    return ev.sort((a, b) => a.at - b.at);
  }

  let events = [], evDay = '', refreshing = false;
  async function refresh() {
    if (refreshing) return; refreshing = true;
    try { events = await dayEvents(0); evDay = ymd(new Date()); scheduleNative(); }
    catch (e) { events = []; }
    finally { refreshing = false; }
    renderTimes();
  }

  function renderTimes() {
    const box = $('#timeList'); box.replaceChildren();
    if (!events.length) box.append(h('p', { class: 'meta' }, 'নামাজের সময় আনা যায়নি। ইন্টারনেট ও অবস্থান সেটিংস দেখুন।'));
    const now = new Date();
    events.filter(e => e.kind === 'azan' || e.kind === 'tahajjud').forEach(e => {
      const cb = h('input', { type: 'checkbox' }); cb.checked = e.on;
      if (e.kind === 'azan') cb.onchange = () => { S.azan[e.key] = cb.checked; persist(); };
      else cb.disabled = true;
      box.append(h('div', { class: 'row' + (e.at < now ? ' past' : '') }, h('span', {}, e.label), h('b', {}, fmtT(e.at)), cb));
    });
    const al = $('#alarmList'); al.replaceChildren();
    S.alarms.forEach(a => {
      const cb = h('input', { type: 'checkbox' }); cb.checked = a.on;
      cb.onchange = () => { a.on = cb.checked; persist(); };
      al.append(h('div', { class: 'row' }, h('span', {}, (a.label || 'অ্যালার্ম') + ' — ' + a.time), cb,
        h('button', { class: 'ghost', onclick: () => { S.alarms = S.alarms.filter(x => x.id !== a.id); persist(); } }, '🗑')));
    });
  }

  $('#alarmForm').onsubmit = e => {
    e.preventDefault();
    S.alarms.push({ id: Date.now().toString(36), time: $('#aTime').value, label: $('#aLabel').value.trim(), on: true, days: [] });
    $('#aLabel').value = ''; persist();
  };
  $('#tjOn').onchange = e => { S.tahajjud.enabled = e.target.checked; persist(); };
  $('#tjMode').onchange = e => { S.tahajjud.mode = e.target.value; $('#tjCustomRow').hidden = e.target.value !== 'custom'; persist(); };
  $('#tjCustom').onchange = e => { S.tahajjud.custom = e.target.value || '03:30'; persist(); };

  /* ---- sound / notification / ring ---- */
  let audio = null, beepTimer = null, ctx = null, current = null;
  function beepOnce() {
    ctx = ctx || new (window.AudioContext || window.webkitAudioContext)();
    const o = ctx.createOscillator(), g = ctx.createGain();
    o.connect(g); g.connect(ctx.destination); o.frequency.value = 880; g.gain.value = 0.2;
    o.start(); o.stop(ctx.currentTime + 0.4);
  }
  function beep(loop) {
    if (beepTimer) return; let n = 0; try { beepOnce(); } catch (e) {}
    beepTimer = setInterval(() => {
      if (!loop && ++n >= 5) { clearInterval(beepTimer); beepTimer = null; return; }
      try { beepOnce(); } catch (e) {}
    }, 1000);
  }
  function stopSound() { if (audio) { audio.pause(); audio = null; } clearInterval(beepTimer); beepTimer = null; }
  function playSound(kind) {
    stopSound();
    const loop = kind !== 'azan';
    audio = new Audio(kind === 'azan' ? 'audio/azan.mp3' : 'audio/alarm.mp3');
    audio.loop = loop;
    audio.addEventListener('error', () => beep(loop));
    audio.play().catch(() => beep(loop));
  }
  async function notify(e) {
    if (!('Notification' in window) || Notification.permission !== 'granted') return;
    const opts = { body: fmtT(e.at), tag: e.id, requireInteraction: true };
    try {
      const reg = navigator.serviceWorker && await navigator.serviceWorker.getRegistration();
      if (reg) return reg.showNotification(e.label, opts);
    } catch (err) {}
    try { new Notification(e.label, opts); } catch (err) {}
  }
  function fire(e) {
    current = e; notify(e); playSound(e.kind); if (navigator.vibrate) navigator.vibrate([500, 200, 500]);
    $('#ringTitle').textContent = e.label; $('#ringTime').textContent = fmtT(e.at);
    $('#snooze').hidden = e.kind === 'azan'; $('#ring').hidden = false;
  }
  $('#stop').onclick = () => { stopSound(); $('#ring').hidden = true; };
  $('#snooze').onclick = () => {
    stopSound(); $('#ring').hidden = true;
    if (current) events.push(Object.assign({}, current, { id: current.id + '-s' + Date.now(), at: new Date(Date.now() + 5 * 60000), on: true }));
  };

  /* ---- scheduler (checks every second) ---- */
  const fired = new Set(load('fired', []));
  function tick() {
    const now = new Date();
    if (ymd(now) !== evDay) refresh();
    for (const e of events) {
      if (!e.on || fired.has(e.id)) continue;
      const d = now - e.at;
      if (d >= 0 && d < 60000) { fired.add(e.id); save('fired', [...fired].slice(-80)); fire(e); }
    }
    const nx = events.find(e => e.on && e.at > now);
    $('#next').textContent = nx
      ? 'পরবর্তী: ' + nx.label + ' — ' + fmtT(nx.at) + ' (' + Math.floor((nx.at - now) / 3600000) + 'ঘ ' + (Math.floor((nx.at - now) / 60000) % 60) + 'মি বাকি)'
      : 'আজকের আর কোনো সময় বাকি নেই';
  }
  setInterval(tick, 1000);

  /* ---- Android (Capacitor): schedule native notifications so they ring when app is closed ---- */
  async function scheduleNative() {
    const LN = window.Capacitor && window.Capacitor.Plugins && window.Capacitor.Plugins.LocalNotifications;
    if (!LN) return;
    try {
      const p = await LN.requestPermissions(); if (p.display !== 'granted') return;
      const pend = await LN.getPending();
      if (pend.notifications.length) await LN.cancel({ notifications: pend.notifications.map(n => ({ id: n.id })) });
      const list = [];
      for (let off = 0; off < 3; off++) {
        const evs = await dayEvents(off);
        const dayNo = Math.floor(addDays(new Date(), off).getTime() / 864e5) % 100000;
        evs.filter(e => e.on && e.at > new Date()).forEach(e => list.push({
          id: dayNo * 100 + e.code, title: e.label, body: fmtT(e.at), schedule: { at: e.at, allowWhileIdle: true }
        }));
      }
      if (list.length) await LN.schedule({ notifications: list });
    } catch (err) { console.warn('native schedule failed', err); }
  }

  /* ---- settings ---- */
  function renderSettings() {
    $('#lat').value = S.lat; $('#lng').value = S.lng; $('#method').value = S.method; $('#school').value = S.school;
    $('#tjOn').checked = S.tahajjud.enabled; $('#tjMode').value = S.tahajjud.mode;
    $('#tjCustom').value = S.tahajjud.custom; $('#tjCustomRow').hidden = S.tahajjud.mode !== 'custom';
  }
  ['lat', 'lng'].forEach(id => { $('#' + id).onchange = e => { const v = parseFloat(e.target.value); if (!Number.isNaN(v)) { S[id] = v; persist(); } }; });
  ['method', 'school'].forEach(id => { $('#' + id).onchange = e => { S[id] = +e.target.value; persist(); }; });
  $('#geo').onclick = () => { if (navigator.geolocation) navigator.geolocation.getCurrentPosition(p => {
    S.lat = +p.coords.latitude.toFixed(4); S.lng = +p.coords.longitude.toFixed(4); renderSettings(); persist();
  }); };
  $('#enable').onclick = async () => {
    if ('Notification' in window) await Notification.requestPermission();
    try { const a = new Audio('audio/azan.mp3'); a.volume = 0; await a.play(); a.pause(); } catch (e) {}
    try { beepOnce(); } catch (e) {}
    scheduleNative();
  };
  $('#test').onclick = () => fire({ id: 'test' + Date.now(), kind: 'azan', label: 'টেস্ট আযান', at: new Date() });

  /* ---- tabs / search / boot ---- */
  document.querySelectorAll('nav button').forEach(b => { b.onclick = () => {
    document.querySelectorAll('nav button').forEach(x => x.classList.toggle('on', x === b));
    ['duas', 'times', 'settings'].forEach(id => { $('#' + id).hidden = id !== b.dataset.tab; });
  }; });
  $('#search').oninput = e => { q = e.target.value.trim().toLowerCase(); renderDuas(); };

  (async () => {
    duas = await loadDuas(); renderDuas(); renderSettings(); await refresh();
    if ('serviceWorker' in navigator && location.protocol.indexOf('http') === 0 && !window.Capacitor)
      navigator.serviceWorker.register('sw.js').catch(() => {});
  })();
}

