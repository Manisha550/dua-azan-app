/* --------------------------- AUDIT / VERIFY ----------------------------- */
const REQUIRED = ['arabic', 'bengali', 'context', 'repetition'];
function schemaProblems(d) {
  const p = [];
  for (const k of REQUIRED) if (typeof d[k] !== 'string' || !d[k].trim()) p.push('missing ' + k);
  if (!d.source || !d.source.type || !d.source.ref) p.push('missing source');
  if (d.source && d.source.type === 'quran' && !(Array.isArray(d.source.ayahs) && d.source.ayahs.length))
    p.push('quran entry needs source.ayahs');
  return p;
}
function loadAll() {
  let list = BUILTIN_DUAS.slice();
  try {
    const extra = JSON.parse(fs.readFileSync(path.join(__dirname, 'duas-extra.json'), 'utf8'));
    if (Array.isArray(extra)) list = list.concat(extra);
  } catch (e) { /* no extra file */ }
  let report = {};
  try { report = JSON.parse(fs.readFileSync(path.join(__dirname, 'audit-report.json'), 'utf8')); } catch (e) {}
  return list.map(function (d) {
    const notes = schemaProblems(d).concat(report[d.id] || []);
    const ok = d.status === 'verified' && notes.length === 0;
    return Object.assign({}, d, { status: ok ? 'verified' : 'needs_verification', auditNotes: notes });
  });
}
const verifiedDuas = () => loadAll().filter(d => d.status === 'verified').map(d => { const c = Object.assign({}, d); delete c.auditNotes; return c; });

const normAr = s => s
  .replace(/[\u064B-\u065F\u0670\u06D6-\u06ED\u0640]/g, '')
  .replace(/[أإآٱ]/g, 'ا').replace(/ى/g, 'ي')
  .replace(/[^\u0621-\u064A\s]/g, ' ').replace(/\s+/g, ' ').trim();

async function runAudit() {
  const all = loadAll(); const report = {};
  for (const d of all) {
    const notes = schemaProblems(d);
    if (d.source && d.source.type === 'quran' && d.source.ayahs) {
      try {
        const words = new Set();
        for (const a of d.source.ayahs) {
          const r = await fetch('https://api.alquran.cloud/v1/ayah/' + a + '/quran-simple-clean');
          const j = await r.json();
          normAr(j.data.text).split(' ').forEach(w => words.add(w));
        }
        const missing = normAr(d.arabic).split(' ').filter(w => !words.has(w));
        if (missing.length) notes.push('words not found in cited ayah(s): ' + missing.join(' '));
      } catch (e) { console.warn('[skip] Quran API not reachable for', d.id); }
    } else if (d.source && d.source.type === 'hadith') {
      console.log('[MANUAL CHECK] ' + d.id + ' -> compare Arabic + number on sunnah.com: ' + d.source.ref);
    }
    if (notes.length) report[d.id] = notes;
  }
  fs.writeFileSync(path.join(__dirname, 'audit-report.json'), JSON.stringify(report, null, 2));
  const bad = Object.keys(report);
  console.log('\nVerified: ' + (all.length - bad.length) + ' | Needs verification: ' + bad.length);
  bad.forEach(id => console.log(' - ' + id + ': ' + report[id].join('; ')));
}

